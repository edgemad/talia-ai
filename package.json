{
  "name": "talia-ai",
  "private": true,
  "version": "0.4.8",
  "type": "module",
  "description": "Talia AI — an adorably cozy local LLM chat companion for Ollama and any OpenAI-compatible server.",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "server": "node server/index.mjs",
    "build": "vite build && node scripts/make-preview.mjs",
    "build:desktop": "vite build && node scripts/build-sidecar.mjs --tauri",
    "sidecar": "node scripts/build-sidecar.mjs --tauri",
    "tauri": "tauri",
    "icons": "node scripts/gen-icons.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "framer-motion": "^12.23.12",
    "lucide-react": "^1.49.0",
    "postcss": "^8.4.49",
    "postject": "^1.0.0-alpha.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
