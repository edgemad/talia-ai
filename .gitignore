node_modules
dist
build
.env
.env.*
*.log
.DS_Store

# Tauri / Rust
src-tauri/target
# The generated Android project is ~650 MB, almost all of it Gradle/Cargo build
# output. It is recreated by `npm run android:init`, so there is no reason for it
# to ever reach a commit. The schemas are small and worth keeping.
src-tauri/gen/android
src-tauri/gen/schemas
# staged sidecar binaries (rebuilt by `npm run sidecar` / CI)
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# Tauri updater signing key — NEVER commit. Keep a backup offline; set it as
# the TAURI_SIGNING_PRIVATE_KEY secret in CI.
.tauri-signing/
